# =========================
# Storage / 知识库与本地存储
# =========================

# RAG 本地存储目录。
# 用途：保存 FAISS 索引、metadata、BM25 索引、评测输出等。
# 填写范围：相对路径或绝对路径；建议保持在项目目录内。
RAG_STORAGE_DIR=RAG/storage

# 默认知识库名称。
# 用途：CLI 查询、评测脚本默认会从这个知识库检索。
# 填写范围：普通字符串；建议只用英文、数字、下划线，例如 resume_kb、prd_kb。
RAG_KNOWLEDGE_BASE=resume_kb

# demo 代码默认知识库名称。
# 用途：不指定知识库时的演示数据隔离。
# 填写范围：普通字符串；建议只用英文、数字、下划线。
RAG_DEMO_KNOWLEDGE_BASE=demo_kb


# =========================
# Vector store / 向量库
# =========================

# 向量库后端。
# 用途：决定向量写入和检索使用 FAISS 还是 Milvus。
# 填写范围：faiss | milvus。
# faiss：本地文件型，最简单；milvus：服务型，适合更大数据量。
RAG_BACKEND=faiss

# Milvus 服务地址。
# 用途：RAG_BACKEND=milvus 时连接 Milvus。
# 填写范围：IP、域名或 localhost。
MILVUS_HOST=localhost

# Milvus 服务端口。
# 用途：RAG_BACKEND=milvus 时连接 Milvus。
# 填写范围：整数端口；Milvus 默认 19530。
MILVUS_PORT=19530

# Milvus collection 名称。
# 用途：Milvus 中保存 chunk 向量和文本的集合名。
# 填写范围：普通字符串；建议英文、数字、下划线。
MILVUS_COLLECTION=rag_chunks


# =========================
# Embedding / 向量化
# =========================

# embedding 方式。
# 用途：决定如何把文本转成向量。
# 填写范围：hash | dashscope | local。
# hash：无需 API，适合本地调试；dashscope：调用兼容 OpenAI 的远程 embedding；local：sentence-transformers 本地模型。
RAG_EMBEDDING=hash

# 远程 embedding 模型名。
# 用途：RAG_EMBEDDING=dashscope 时生效。
# 填写范围：服务商支持的 embedding 模型名，例如 text-embedding-v3。
RAG_EMBEDDING_MODEL=text-embedding-v3

# embedding 向量维度。
# 用途：向量库建库、向量写入和检索时保持维度一致。
# 填写范围：正整数；DashScope text-embedding-v3 常用 1024。
# 注意：改维度后通常需要清空旧索引并重新入库。
RAG_EMBEDDING_DIM=1024

# DashScope API Key。
# 用途：RAG_EMBEDDING=dashscope、评测或关键词抽取使用 DashScope 时需要。
# 填写范围：真实 API Key；不要填写中文占位符。
DASHSCOPE_API_KEY=

# DashScope OpenAI-compatible API 地址。
# 用途：远程 embedding、评测 LLM、关键词抽取默认使用。
# 填写范围：http/https URL。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI-compatible API Key 兜底项。
# 用途：当 RAG_EVAL_API_KEY / RAG_KEYWORD_API_KEY / DASHSCOPE_API_KEY 为空时作为备用。
# 填写范围：真实 API Key；不用可留空。
OPENAI_API_KEY=

# 本地 embedding 模型。
# 用途：RAG_EMBEDDING=local 时由 sentence-transformers 加载。
# 填写范围：HuggingFace 模型名或本地模型路径。
RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5


# =========================
# Chunking / 文档切分
# =========================

# 文档切分器。
# 用途：决定文件入库时如何解析和切块。
# 填写范围：simple | deepdoc。
# simple：适合 txt/md/json 等文本文件；deepdoc：适合 PDF/DOCX，带版面/OCR/表格解析链路。
RAG_CHUNKER=simple

# simple chunk 的最大字符数。
# 用途：RAG_CHUNKER=simple 时控制每个 chunk 大小。
# 填写范围：正整数；建议 500-1200。
RAG_CHUNK_SIZE=800

# simple chunk 的重叠字符数。
# 用途：避免切块边界丢上下文。
# 填写范围：0 到 RAG_CHUNK_SIZE 之间；建议为 chunk_size 的 10%-20%。
RAG_CHUNK_OVERLAP=120


# =========================
# Hybrid retrieval / 混合检索
# =========================

# 是否开启混合检索。
# 用途：false 只走向量召回；true 走向量召回 + BM25 召回，再融合重排。
# 填写范围：true | false。
RAG_HYBRID_ENABLED=false

# 向量分数融合权重。
# 用途：RAG_HYBRID_ENABLED=true 时控制最终分数里向量分数占比。
# 填写范围：0.0-1.0。
# 例：0.7 表示 70% 向量分数 + 30% BM25 分数。
RAG_HYBRID_VECTOR_WEIGHT=0.7

# 混合检索候选数量。
# 用途：RAG_HYBRID_ENABLED=true 时，向量和 BM25 各先召回多少候选，再合并重排。
# 填写范围：正整数；建议 20-100。
# 注意：这不是最终返回条数，最终返回条数由 top_k / RAG_EVAL_TOP_K 控制。
RAG_HYBRID_CANDIDATE_K=20

# BM25 k1 参数。
# 用途：控制词频饱和程度，词重复出现多次时加分幅度。
# 填写范围：通常 1.2-2.0；常用默认 1.5。
RAG_BM25_K1=1.5

# BM25 b 参数。
# 用途：控制文本长度归一化程度，避免长 chunk 因词多更容易命中。
# 填写范围：0.0-1.0；常用默认 0.75。
RAG_BM25_B=0.75

# 是否输出检索调试信息。
# 用途：true 时结果中会带 vector_score、term_score 等调试分数。
# 填写范围：true | false。
RAG_RETRIEVAL_DEBUG=false


# =========================
# Query decomposition / 复合问题拆解
# =========================

# 是否在检索前拆解复合问题。
# 用途：true 时会先把“谁编写的，日期是什么”拆成多个子问题分别检索。
# 填写范围：true | false。
RAG_QUERY_DECOMPOSITION_ENABLED=true

# 问题拆解 API Key。
# 用途：优先用于 LLM 问题拆解；为空则依次尝试 DASHSCOPE_API_KEY、OPENAI_API_KEY。
# 填写范围：真实 API Key；为空时会使用本地规则兜底拆解。
RAG_QUERY_DECOMPOSITION_API_KEY=

# 问题拆解 API 地址。
# 用途：OpenAI-compatible chat 接口地址。
# 填写范围：http/https URL。
RAG_QUERY_DECOMPOSITION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 问题拆解模型。
# 用途：将复合问题拆成多个可独立检索的子问题。
# 填写范围：OpenAI-compatible chat 模型名，例如 qwen-plus。
RAG_QUERY_DECOMPOSITION_MODEL=qwen-plus

# 最多拆成多少个子问题。
# 用途：限制检索次数和上下文长度。
# 填写范围：正整数；建议 2-5。
RAG_QUERY_DECOMPOSITION_MAX_SUBQUERIES=4


# =========================
# Intent recognition / 意图识别
# =========================

# 是否启用 LLM 兜底意图识别。
# 用途：false 使用规则识别，快且稳定；true 时规则无法判断再调用 LLM 分类。
# 填写范围：true | false。
# 注意：开启 true 需要可用的 RAG_EVAL_API_KEY / DASHSCOPE_API_KEY / OPENAI_API_KEY。
RAG_INTENT_USE_LLM=false


# =========================
# Generated QA / 入库预生成问答
# =========================

# 是否在文档入库时生成固定 QA records。
# 用途：true 时会用较强模型根据文档 chunks 生成“问题-答案”，并作为额外记录写入向量库。
# 填写范围：true | false。
# 注意：开启后需要配置 RAG_QA_GENERATION_API_KEY / DASHSCOPE_API_KEY / OPENAI_API_KEY。
RAG_QA_GENERATION_ENABLED=false

# QA 生成 API Key。
# 用途：优先用于文档入库时的 QA 生成；为空则依次尝试 DASHSCOPE_API_KEY、OPENAI_API_KEY。
# 填写范围：真实 API Key；不用可留空。
RAG_QA_GENERATION_API_KEY=

# QA 生成 API 地址。
# 用途：OpenAI-compatible chat 接口地址。
# 填写范围：http/https URL。
RAG_QA_GENERATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# QA 生成模型。
# 用途：文档入库时生成高质量固定问答。
# 填写范围：OpenAI-compatible chat 模型名；建议用比评测更强的模型，例如 qwen-max。
RAG_QA_GENERATION_MODEL=qwen-max

# QA 生成 temperature。
# 用途：控制生成 QA 的开放度；入库数据应稳定、忠实，所以建议较低。
# 填写范围：0.0-1.0；建议 0.0-0.3。
RAG_QA_GENERATION_TEMPERATURE=0.2

# QA 生成时最多传给模型的文档上下文字符数。
# 用途：控制入库生成 QA 的 prompt 长度和成本。
# 填写范围：正整数；建议 6000-20000。
RAG_QA_GENERATION_MAX_CONTEXT_CHARS=8000

# 每个文档最多生成多少组 QA。
# 用途：控制额外写入向量库的 QA records 数量。
# 填写范围：正整数；建议 10-50。
RAG_QA_GENERATION_MAX_PAIRS=20

# PDF 首页补充信息读取页数。
# 用途：QA 生成前先读取 PDF 前 N 页，通常用于提取封面、版本、范围、目录和修订记录信息。
# 填写范围：正整数；建议 2-6。
RAG_QA_PDF_PREVIEW_PAGES=4

# 是否先用 LLM 提炼 PDF 前几页内容。
# 用途：true 时先把前几页原文压缩成要点，再加入 QA 生成上下文；false 时直接截断加入原文。
# 填写范围：true | false。
RAG_QA_PDF_PREVIEW_SUMMARY_ENABLED=true

# PDF 前几页原文最多送入提炼模型的字符数。
# 用途：控制提炼步骤的 prompt 长度和成本。
# 填写范围：正整数；建议 8000-20000。
RAG_QA_PDF_PREVIEW_MAX_CHARS=12000

# PDF 前几页提炼摘要的最大字符数。
# 用途：控制最终加入 QA 生成上下文的补充信息长度。
# 填写范围：正整数；建议 800-3000。
RAG_QA_PDF_PREVIEW_SUMMARY_MAX_CHARS=1200

# =========================
# Keyword extraction / 关键词抽取
# =========================

# 关键词抽取 API Key。
# 用途：需要远程模型抽取 query 关键词时使用；为空则回退本地正则/分词。
# 填写范围：真实 API Key；不用可留空。
RAG_KEYWORD_API_KEY=

# 关键词抽取 API 地址。
# 用途：OpenAI-compatible chat 接口地址。
# 填写范围：http/https URL。
RAG_KEYWORD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 关键词抽取模型名。
# 用途：调用远程模型抽取关键词时使用。
# 填写范围：OpenAI-compatible chat 模型名，例如 qwen-plus。
RAG_KEYWORD_MODEL=qwen-plus


# =========================
# DeepDoc / RAGFlow compatibility
# =========================

# DeepDoc/RAGFlow 兼容项目根目录。
# 用途：少数保留的 DeepDoc 兼容 helper 会读取它来定位资源。
# 填写范围：目录路径；通常留空。
RAG_PROJECT_BASE=

# DeepDoc/RAGFlow 兼容部署根目录。
# 用途：RAG_PROJECT_BASE 为空时的兼容备用路径。
# 填写范围：目录路径；通常留空。
RAG_DEPLOY_BASE=

# Elasticsearch 地址。
# 用途：RAGFlow 残留 ES 连接代码读取；当前主链路一般不用。
# 填写范围：http/https URL；不用可留空。
ES_URL=


# =========================
# RAG QA evaluation / RAG 问答评测
# =========================

# 最终分数中 LLM 语义评分的权重。
# 用途：final_accuracy = K * llm_accuracy + (1 - K) * keyword_coverage。
# 填写范围：0.0-1.0。
# 如果答案关键词为空，则语义评分承担全部分数。
RAG_EVAL_K=0.7

# 评测时每个问题取多少条检索结果。
# 用途：传给 RagService.retrieve(..., top_k=RAG_EVAL_TOP_K)。
# 填写范围：正整数；建议 3-10。
RAG_EVAL_TOP_K=5

# 拼给生成模型的最大上下文字符数。
# 用途：限制检索内容长度，避免 prompt 过长。
# 填写范围：正整数；建议 3000-12000。
RAG_EVAL_MAX_CONTEXT_CHARS=6000

# 评测输出目录。
# 用途：保存 detail、low_score、summary、log。
# 填写范围：相对路径或绝对路径。
RAG_EVAL_OUTPUT_DIR=RAG/data/eval_outputs

# 低分样本阈值。
# 用途：final_accuracy 低于该值时写入 eval_low_scores_*.jsonl。
# 填写范围：0.0-1.0。
RAG_EVAL_LOW_SCORE_THRESHOLD=0.6

# 是否断点续跑。
# 用途：true 时读取已有 eval_details_<run_id>.jsonl，跳过已成功 case。
# 填写范围：true | false。
RAG_EVAL_RESUME=false

# 断点续跑时是否重跑失败 case。
# 用途：true 跳过成功但重跑失败；false 成功和失败都跳过。
# 填写范围：true | false。
RAG_EVAL_RETRY_FAILED=true

# 指定续跑的 run_id。
# 用途：为空时新跑会生成当前时间戳；resume=true 且为空时会自动找最新 eval_details_*.jsonl。
# 填写范围：eval_details_<run_id>.jsonl 中间的 run_id，例如 20260514_130200；不指定就留空。
RAG_EVAL_RUN_ID=

# 评测答案模式。
# 用途：llm 表示检索后让 LLM 生成答案；context 表示直接把检索上下文作为 RAG 输出评测。
# 填写范围：llm | context。
RAG_EVAL_ANSWER_MODE=llm

# 评测 LLM API Key。
# 用途：生成答案和裁判评分使用；为空时依次尝试 DASHSCOPE_API_KEY、OPENAI_API_KEY。
# 填写范围：真实 API Key；不要填写中文占位符。
RAG_EVAL_API_KEY=

# 评测 LLM API 地址。
# 用途：OpenAI-compatible chat 接口地址。
# 填写范围：http/https URL。
RAG_EVAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 评测 LLM 模型名。
# 用途：生成答案和裁判评分使用。
# 填写范围：OpenAI-compatible chat 模型名，例如 qwen-plus。
RAG_EVAL_MODEL=qwen-plus

# 单次 LLM 请求超时时间，单位秒。
# 用途：避免网络或服务异常时卡住。
# 填写范围：正整数；建议 30-120。
RAG_EVAL_LLM_TIMEOUT=60

# LLM 调用失败后的重试次数。
# 用途：网络抖动、限流等临时错误自动重试。
# 填写范围：正整数；建议 1-5。
RAG_EVAL_LLM_RETRIES=3

# LLM 重试基础等待时间，单位秒。
# 用途：第 n 次失败后大约等待 n * RAG_EVAL_LLM_RETRY_DELAY 秒再重试。
# 填写范围：大于等于 0 的数字；建议 0.5-3.0。
RAG_EVAL_LLM_RETRY_DELAY=1.0

# 没有配置 LLM 时是否允许继续跑。
# 用途：true 时缺少 API Key 会降级，例如使用检索上下文；false 时直接报错。
# 填写范围：true | false。
RAG_EVAL_ALLOW_MISSING_LLM=false
